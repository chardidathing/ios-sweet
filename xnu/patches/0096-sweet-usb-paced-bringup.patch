+/*
+ * Bring-up pacing: the persistent log flushes about once a second and a
+ * hung bus resets the SoC within that second, so each start-up step waits
+ * for its line to reach the disk (boot-arg sweetusbpace, ms, default 2000).
+ */
+static unsigned usb_pace_ms = 2000;
+static int usb_pace_chan;
+
+static void
+usb_pace(void)
+{
+	uint64_t deadline;
+	if (usb_pace_ms == 0) {
+		return;
+	}
+	clock_interval_to_deadline(usb_pace_ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&usb_pace_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
