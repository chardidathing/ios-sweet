diff --git a/bsd/dev/sweet_geni.c b/bsd/dev/sweet_geni.c
index d9827e5..191b956 100644
--- a/bsd/dev/sweet_geni.c
+++ b/bsd/dev/sweet_geni.c
@@ -99,13 +99,18 @@ sweet_geni_clocks(const char *tag, vm_offset_t gcc, uint32_t vote, uint32_t vote
 			return false;
 		}
 	}
+	/* A halted branch is reported, not fatal: on kona the wrapper AHB halt
+	 * bits read set with the vote in place, and the SE probe below is the
+	 * real test of whether the bus is clocked. */
+	bool all = true;
 	for (unsigned i = 0; i < nhalts; ++i) {
 		if (!sweet_mmio_wait_clear(gcc, halts[i], 1u << 31)) {
 			printf("%s: GCC branch %#x halted (%#x)\n", tag, halts[i],
 			    sweet_mmio_rd(gcc, halts[i]));
-			return false;
+			all = false;
 		}
 	}
+	printf("%s: GCC branches %s\n", tag, all ? "running" : "not all running, probing anyway");
 	return true;
 }
 
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
