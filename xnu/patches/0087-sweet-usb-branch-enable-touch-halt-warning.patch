 		    (cbcr[i] & CBCR_CLK_OFF) ? "off" : "on");
 	}
+	/* ABL leaves branches off after a fastboot reboot (kona: the UTMI clock,
+	 * without which endpoint commands never complete). Turn on every
+	 * described branch that is off, as the Linux clock driver would. */
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		if (usb_cbcr_off[i] == 0 || !(cbcr[i] & CBCR_CLK_OFF)) {
+			continue;
+		}
+		*(volatile uint32_t *)(gcc + usb_cbcr_off[i]) = cbcr[i] | 1u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (unsigned j = 0; j < 5000 && (usb_rd(gcc, usb_cbcr_off[i]) & CBCR_CLK_OFF); j++) {
+			delay(1);
+		}
+		cbcr[i] = usb_rd(gcc, usb_cbcr_off[i]);
+		printf("SWEET USB: clk %-12s enabled -> CBCR 0x%08x (%s)\n", usb_cbcr[i].name, cbcr[i],
+		    (cbcr[i] & CBCR_CLK_OFF) ? "still off" : "on");
+	}
 	/* DWC3 registers need the GDSC, the master clock and the config-NoC path. */
 	clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
