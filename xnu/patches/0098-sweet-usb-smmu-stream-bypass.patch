+/*
+ * SMMUv2 global register space 0 (Linux arm-smmu.c). ABL leaves USB's stream
+ * matched to its own translation context; a DMA to our memory through those
+ * stale tables stalls the bus and resets the SoC. Linux installs its own
+ * context, here the stream simply bypasses translation.
+ */
+#define SMMU_SCR0           0x000
+#define   SCR0_CLIENTPD     (1u << 0)
+#define   SCR0_USFCFG       (1u << 10)
+#define SMMU_IDR0           0x020
+#define   IDR0_NUMSMRG(v)   ((v) & 0xffu)
+#define   IDR0_EXIDS        (1u << 8)
+#define   IDR0_SMS          (1u << 31)
+#define SMMU_SMR(n)         (0x800u + 4u * (n))
+#define   SMR_VALID         (1u << 31)
+#define SMMU_S2CR(n)        (0xc00u + 4u * (n))
+#define   S2CR_TYPE_MASK    (3u << 16)
+#define   S2CR_TYPE_BYPASS  (1u << 16)
+#define   S2CR_EXIDVALID    (1u << 10)
+
+static void
+usb_smmu_bypass(void)
+{
+	if (usb_smmu_pa == 0) {
+		return;
+	}
+	vm_offset_t smmu = ml_io_map((vm_offset_t)usb_smmu_pa, 0x1000);
+	if (smmu == 0) {
+		return;
+	}
+	uint32_t scr0 = usb_rd(smmu, SMMU_SCR0), idr0 = usb_rd(smmu, SMMU_IDR0);
+	unsigned nsmr = IDR0_NUMSMRG(idr0);
+	bool exids = (idr0 & IDR0_EXIDS) != 0;
+	printf("SWEET USB: SMMU sCR0 0x%08x IDR0 0x%08x: %u stream match groups%s%s\n", scr0, idr0, nsmr,
+	    (scr0 & SCR0_CLIENTPD) ? ", client port disabled (global bypass)" : "",
+	    (scr0 & SCR0_USFCFG) ? ", unmatched streams fault" : ", unmatched streams bypass");
+	if ((scr0 & SCR0_CLIENTPD) || !(idr0 & IDR0_SMS) || nsmr == 0) {
+		return;
+	}
+	int found = -1, spare = -1;
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t smr = usb_rd(smmu, SMMU_SMR(i)), s2cr = usb_rd(smmu, SMMU_S2CR(i));
+		bool valid = exids ? (s2cr & S2CR_EXIDVALID) != 0 : (smr & SMR_VALID) != 0;
+		uint32_t id = exids ? (smr & 0xffffu) : (smr & 0x7fffu);
+		uint32_t mask = exids ? (smr >> 16) : ((smr >> 16) & 0x7fffu);
+		if (!valid) {
+			if (spare < 0) {
+				spare = (int)i;
+			}
+			continue;
+		}
+		if ((id & ~mask) == (usb_smmu_sid & ~mask)) {
+			printf("SWEET USB: SMMU stream 0x%x matched by group %u: SMR 0x%08x S2CR 0x%08x\n",
+			    usb_smmu_sid, i, smr, s2cr);
+			found = (int)i;
+			break;
+		}
+	}
+	if (found >= 0) {
+		uint32_t s2cr = usb_rd(smmu, SMMU_S2CR(found));
+		*(volatile uint32_t *)(smmu + SMMU_S2CR(found)) = (s2cr & ~S2CR_TYPE_MASK) | S2CR_TYPE_BYPASS;
+	} else if (!(scr0 & SCR0_USFCFG)) {
+		printf("SWEET USB: SMMU stream 0x%x unmatched, already bypasses\n", usb_smmu_sid);
+		return;
+	} else if (spare >= 0) {
+		found = spare;
+		if (exids) {
+			*(volatile uint32_t *)(smmu + SMMU_SMR(found)) = usb_smmu_sid;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			*(volatile uint32_t *)(smmu + SMMU_S2CR(found)) = S2CR_TYPE_BYPASS | S2CR_EXIDVALID;
+		} else {
+			*(volatile uint32_t *)(smmu + SMMU_S2CR(found)) = S2CR_TYPE_BYPASS;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			*(volatile uint32_t *)(smmu + SMMU_SMR(found)) = SMR_VALID | usb_smmu_sid;
+		}
+	} else {
+		printf("SWEET USB: SMMU has no spare stream match group for stream 0x%x\n", usb_smmu_sid);
+		return;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET USB: SMMU group %d now SMR 0x%08x S2CR 0x%08x (bypass)\n", found,
+	    usb_rd(smmu, SMMU_SMR(found)), usb_rd(smmu, SMMU_S2CR(found)));
+}
