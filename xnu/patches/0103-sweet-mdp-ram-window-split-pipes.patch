diff --git a/bsd/dev/sweet_smmu.h b/bsd/dev/sweet_smmu.h
new file mode 100644
index 0000000..b017724
--- /dev/null
+++ b/bsd/dev/sweet_smmu.h
@@ -0,0 +1,28 @@
+/*
+ * SMMUv2 context of our own for one device stream (sweet_smmu.c): an
+ * identity context (translation off), or one with a linear window over the
+ * kernel's RAM for devices whose address registers are 32 bits wide.
+ */
+#ifndef _SWEET_SMMU_H
+#define _SWEET_SMMU_H
+
+#include <stdint.h>
+#include <mach/vm_types.h>
+
+struct sweet_smmu_ctx {
+	vm_offset_t base;       /* mapped SMMU */
+	vm_offset_t cb;         /* mapped context bank, 0 when attach failed */
+	uint64_t ram_base;      /* window: iova 0 is this physical address */
+	uint64_t ram_size;
+	uint32_t sctlr;         /* the bank's SCTLR without M */
+};
+
+/* point the stream at a context bank of ours: identity when ram_size is 0,
+ * else page tables that map iova [0, ram_size) to [ram_base, ...) are
+ * built and installed with translation still off. 0 on success */
+int sweet_smmu_attach(struct sweet_smmu_ctx *c, const char *tag, uint64_t smmu_pa, uint32_t sid,
+    uint64_t ram_base, uint64_t ram_size);
+/* turn the window on (SCTLR.M), from then on the device uses iovas */
+void sweet_smmu_translate(struct sweet_smmu_ctx *c);
+
+#endif /* _SWEET_SMMU_H */
