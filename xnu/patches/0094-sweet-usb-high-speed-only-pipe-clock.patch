 } ud;
 
 static inline void
@@ -1185,6 +1193,26 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
 		return;
 	}
+	vm_offset_t qs = ml_io_map((vm_offset_t)usb_qscratch_pa, 0x100);
+	if (qs != 0 && ud.hs_only) {
+		/*
+		 * High speed only, as dwc3-msm does after the controller reset when
+		 * there is no SuperSpeed PHY: the pipe clock domain runs from the
+		 * UTMI clock and PHYSTATUS is forced, so endpoint commands complete
+		 * with the SS PHY (and its pipe clock) powered down.
+		 */
+		volatile uint32_t *cfg = (volatile uint32_t *)(qs + QSCRATCH_GENERAL_CFG);
+		uint32_t before = *cfg;
+		*cfg = before | PIPE_UTMI_CLK_DIS;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(5);
+		*cfg = *cfg | PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(5);
+		*cfg = *cfg & ~PIPE_UTMI_CLK_DIS;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("SWEET USB: high speed only: GENERAL_CFG 0x%08x -> 0x%08x\n", before, *cfg);
+	}
 
