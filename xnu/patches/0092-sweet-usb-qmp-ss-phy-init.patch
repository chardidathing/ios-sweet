+/* phy-msm-ssusb-qmp.c: indexes into ssphy-reg, and the bits it writes */
+enum {
+	QMP_PCS_STATUS, QMP_AUTONOMOUS_MODE_CTRL, QMP_LFPS_RXTERM_IRQ_CLEAR, QMP_POWER_DOWN_CONTROL,
+	QMP_SW_RESET, QMP_START, QMP_PCS_MISC_TYPEC_CTRL, QMP_DP_PHY_PD_CTL, QMP_DP_COM_POWER_DOWN_CTRL,
+	QMP_DP_COM_SW_RESET, QMP_DP_COM_RESET_OVRD_CTRL, QMP_DP_COM_PHY_MODE_CTRL, QMP_DP_COM_TYPEC_CTRL,
+	QMP_DP_COM_SWI_CTRL, QMP_PCS_MISC_CLAMP_ENABLE,
+};
+#define QMP_PHYSTATUS           (1u << 6)
+#define QMP_RESET_OVRD_ALL      0xfu    /* SW_DPPHY_RESET(_MUX) | SW_USB3PHY_RESET(_MUX) */
+#define QMP_USB3_DP_COMBO_MODE  3u
+
+static void
+qmp_wr(vm_offset_t phy, unsigned reg, uint32_t val)
+{
+	*(volatile uint32_t *)(phy + usb_ssphy_reg[reg]) = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+gcc_bcr(vm_offset_t gcc, uint32_t off, bool assert_reset)
+{
+	uint32_t v = usb_rd(gcc, off);
+	*(volatile uint32_t *)(gcc + off) = assert_reset ? (v | 1u) : (v & ~1u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(100);
+}
+
+/*
+ * The USB3/DP combo QMP PHY as Linux msm_ssphy_qmp_dp_combo_reset +
+ * msm_ssphy_qmp_init bring it up (USB3+DP mode, no lane select: SuperSpeed
+ * itself is not the goal, the PLL feeding the DWC3 pipe clock is). Then the
+ * pipe clock branch can run.
+ */
+static void
+usb_ssphy_init(vm_offset_t gcc)
+{
+	if (usb_ssphy_pa == 0) {
+		return;
+	}
+	vm_offset_t phy = ml_io_map((vm_offset_t)usb_ssphy_pa, 0x3000);
+	if (phy == 0) {
+		return;
+	}
+	printf("SWEET USB: SS PHY before: status 0x%02x pd 0x%02x mode 0x%02x\n",
+	    usb_rd(phy, usb_ssphy_reg[QMP_PCS_STATUS]), usb_rd(phy, usb_ssphy_reg[QMP_POWER_DOWN_CONTROL]),
+	    usb_rd(phy, usb_ssphy_reg[QMP_DP_COM_PHY_MODE_CTRL]));
+	/* global reset held while the PHY reset pulses */
+	gcc_bcr(gcc, usb_ssphy_reset[0], true);
+	gcc_bcr(gcc, usb_ssphy_reset[1], true);
+	gcc_bcr(gcc, usb_ssphy_reset[1], false);
+	gcc_bcr(gcc, usb_ssphy_reset[0], false);
+	/* power up, override both PHY resets, combo mode, release the override */
+	qmp_wr(phy, QMP_DP_COM_POWER_DOWN_CTRL, 1);
+	qmp_wr(phy, QMP_POWER_DOWN_CONTROL, 1);
+	qmp_wr(phy, QMP_DP_COM_RESET_OVRD_CTRL, QMP_RESET_OVRD_ALL);
+	qmp_wr(phy, QMP_DP_COM_PHY_MODE_CTRL, QMP_USB3_DP_COMBO_MODE);
+	(void)usb_rd(phy, usb_ssphy_reg[QMP_DP_COM_PHY_MODE_CTRL]);
+	qmp_wr(phy, QMP_DP_COM_RESET_OVRD_CTRL, 0);
+	qmp_wr(phy, QMP_DP_COM_POWER_DOWN_CTRL, 1);
+	qmp_wr(phy, QMP_POWER_DOWN_CONTROL, 1);
+	for (unsigned i = 0; i < usb_ssphy_nseq; i++) {
+		*(volatile uint32_t *)(phy + usb_ssphy_seq[3 * i]) = usb_ssphy_seq[3 * i + 1];
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (usb_ssphy_seq[3 * i + 2]) {
+			delay(usb_ssphy_seq[3 * i + 2] + 10);
+		}
+	}
+	qmp_wr(phy, QMP_DP_COM_SW_RESET, 0);
+	qmp_wr(phy, QMP_SW_RESET, 0);
+	qmp_wr(phy, QMP_START, 3);
+	unsigned i;
+	for (i = 0; i < 10000 && (usb_rd(phy, usb_ssphy_reg[QMP_PCS_STATUS]) & QMP_PHYSTATUS); i++) {
+		delay(1);
+	}
+	printf("SWEET USB: SS PHY %s after %u us (status 0x%02x)\n",
+	    (usb_rd(phy, usb_ssphy_reg[QMP_PCS_STATUS]) & QMP_PHYSTATUS) ? "NOT ready" : "ready", i,
+	    usb_rd(phy, usb_ssphy_reg[QMP_PCS_STATUS]));
+	if (usb_cbcr_off[9] != 0) {
+		uint32_t v = usb_rd(gcc, usb_cbcr_off[9]);
+		*(volatile uint32_t *)(gcc + usb_cbcr_off[9]) = v | 1u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (i = 0; i < 5000 && (usb_rd(gcc, usb_cbcr_off[9]) & CBCR_CLK_OFF); i++) {
+			delay(1);
+		}
+		printf("SWEET USB: clk phy-pipe enabled -> CBCR 0x%08x (%s)\n", usb_rd(gcc, usb_cbcr_off[9]),
+		    (usb_rd(gcc, usb_cbcr_off[9]) & CBCR_CLK_OFF) ? "still off" : "on");
+	}
+}
