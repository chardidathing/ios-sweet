 {
-	uint64_t row = (uint64_t)sweet_div_up(width, ew) * bpe;
 	return (uint32_t)((row + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
 }
 
+static uint32_t
+sweet_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
+{
+	return sweet_row_align((uint64_t)sweet_div_up(width, ew) * bpe);
+}
+
+/*
+ * row bytes for an explicit value (0: none). explicit rows are rounded up
+ * to the alignment too: the adreno texture and render target pitch needs
+ * 64-byte rows, and CA takes the real value from the lock result
+ * (SpringBoard asks for 833 px in 3360 bytes and renders into it on the
+ * gpu). bare geometry requests (6 keys or fewer) get them as asked: CoreUI
+ * fills its glyph surfaces with the row bytes it asked for (sweetgl copies
+ * those). the key count is what tells CoreUI from CA, if that stops
+ * working a creator's backtrace is the next thing to look at.
+ */
+static uint32_t
+sweet_rows(uint32_t asked, uint32_t width, uint32_t ew, uint32_t bpe, unsigned int keys)
+{
+	if (asked == 0) {
+		return sweet_row_bytes(width, ew, bpe);
+	}
+	return keys <= 6 ? asked : sweet_row_align(asked);
+}
