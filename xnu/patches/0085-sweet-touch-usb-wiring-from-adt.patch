diff --git a/bsd/dev/sweet_geni.c b/bsd/dev/sweet_geni.c
new file mode 100644
index 0000000..d9827e5
--- /dev/null
+++ b/bsd/dev/sweet_geni.c
@@ -0,0 +1,315 @@
+/*
+ * Polled FIFO-mode I2C on a GENI serial engine (see sweet_geni.h). This is
+ * the engine that drove sweet's GT9896 on SE7, moved out of sweet_touch.c
+ * so other boards and ICs can use it; register offsets follow the Linux
+ * qcom-geni-se / i2c-qcom-geni drivers.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include "sweet_geni.h"
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+uint32_t
+sweet_mmio_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+sweet_mmio_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+bool
+sweet_mmio_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(sweet_mmio_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+bool
+sweet_geni_clocks(const char *tag, vm_offset_t gcc, uint32_t vote, uint32_t vote_mask,
+    uint32_t rcg, const uint32_t *halts, unsigned nhalts)
+{
+	/* Vote on only the wrapper and this SE, preserving other clock users. */
+	sweet_mmio_wr(gcc, vote, sweet_mmio_rd(gcc, vote) | vote_mask);
+	uint32_t dfs = sweet_mmio_rd(gcc, rcg + 0x14u);
+	uint32_t cfg = sweet_mmio_rd(gcc, rcg + 4u);
+	printf("%s: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n", tag,
+	    sweet_mmio_rd(gcc, vote), sweet_mmio_rd(gcc, rcg), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+		cfg = sweet_mmio_rd(gcc, rcg + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("%s: DFS level0=%#x is not XO/1; need clock integration\n", tag, cfg);
+			return false;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		sweet_mmio_wr(gcc, rcg + 4u, cfg);
+		sweet_mmio_wr(gcc, rcg, sweet_mmio_rd(gcc, rcg) | 1u);
+		if (!sweet_mmio_wait_clear(gcc, rcg, 1u)) {
+			printf("%s: RCG update timeout\n", tag);
+			return false;
+		}
+	}
+	for (unsigned i = 0; i < nhalts; ++i) {
+		if (!sweet_mmio_wait_clear(gcc, halts[i], 1u << 31)) {
+			printf("%s: GCC branch %#x halted (%#x)\n", tag, halts[i],
+			    sweet_mmio_rd(gcc, halts[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+geni_abort(struct sweet_geni *g)
+{
+	sweet_mmio_wr(g->se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (sweet_mmio_rd(g->se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !sweet_mmio_wait_clear(g->se, SE_STATUS, 1u)) {
+		g->dead = true;
+		printf("%s: abort failed status=%#x irq=%#x; stopping\n", g->tag,
+		    sweet_mmio_rd(g->se, SE_STATUS), sweet_mmio_rd(g->se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (sweet_mmio_rd(g->se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)sweet_mmio_rd(g->se, SE_RX);
+	}
+	sweet_mmio_wr(g->se, SE_IRQ_CLR, 0xffffffffu);
+	if (sweet_mmio_rd(g->se, SE_TX_COUNT) & 0xfffffffu) {
+		g->dead = true;
+		printf("%s: TX FIFO not empty after abort; stopping\n", g->tag);
+	}
+}
+
+/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
+static uint32_t
+geni_irq(struct sweet_geni *g)
+{
+	g->irq_last = sweet_mmio_rd(g->se, SE_IRQ);
+	g->irq_status |= g->irq_last;
+	return g->irq_last;
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+geni_msg_run(struct sweet_geni *g, uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (g->dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!sweet_mmio_wait_clear(g->se, SE_STATUS, 1u)) {
+		g->dead = true; /* no other owner of this SE is supported */
+		return EBUSY;
+	}
+	sweet_mmio_wr(g->se, SE_IRQ_CLR, 0xffffffffu);
+	sweet_mmio_wr(g->se, SE_TX_WM, nt ? 1u : 0u);
+	sweet_mmio_wr(g->se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	sweet_mmio_wr(g->se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = geni_irq(g);
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the next transfer. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = geni_irq(g);
+			}
+			if ((irq & SE_DONE) && !(sweet_mmio_rd(g->se, SE_STATUS) & 1u) &&
+			    !(sweet_mmio_rd(g->se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(sweet_mmio_rd(g->se, SE_RX_COUNT) & 0x1ffffffu)) {
+				sweet_mmio_wr(g->se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !g->sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			sweet_mmio_wr(g->se, SE_TX, word);
+			g->sent = nt;
+			sweet_mmio_wr(g->se, SE_TX_WM, 0);
+		}
+		uint32_t count = sweet_mmio_rd(g->se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - g->got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = sweet_mmio_rd(g->se, SE_RX);
+			for (unsigned j = 0; j < 4 && g->got < nr; ++j) {
+				rx[g->got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			/* Re-sample after the final drain; a late error must beat DONE. */
+			irq = geni_irq(g);
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			sweet_mmio_wr(g->se, SE_IRQ_CLR, irq);
+			if (g->got == nr && g->sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		sweet_mmio_wr(g->se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	geni_abort(g);
+	return err;
+}
+
+int
+sweet_geni_msg(struct sweet_geni *g, uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	g->irq_status = g->irq_last = 0;
+	g->sent = g->got = 0;
+	int err = geni_msg_run(g, addr, tx, nt, rx, nr, stretch);
+	if (g->probing) {
+		printf("%s: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+		    g->tag, addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+		    err, g->irq_last, g->irq_status, g->sent, g->got,
+		    sweet_mmio_rd(g->se, SE_STATUS));
+	}
+	return err;
+}
+
+int
+sweet_geni_read(struct sweet_geni *g, uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = sweet_geni_msg(g, addr, wide ? ptr : ptr + 1, wide ? 2u : 1u, NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return sweet_geni_msg(g, addr, NULL, 0, buf, len, false);
+}
+
+bool
+sweet_geni_setup(struct sweet_geni *g)
+{
+	vm_offset_t se = g->se;
+	uint32_t fw = sweet_mmio_rd(se, SE_FW);
+	uint32_t tx = sweet_mmio_rd(se, SE_HW_TX), rx = sweet_mmio_rd(se, SE_HW_RX);
+	printf("%s: se fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n", g->tag,
+	    fw, (fw >> 8) & 0xffu, sweet_mmio_rd(se, SE_STATUS), tx, rx,
+	    sweet_mmio_rd(se, 0x908));
+	if (((fw >> 8) & 0xffu) != 3u || (sweet_mmio_rd(se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("%s: need ABL-loaded I2C firmware and 32-bit FIFOs; probes skipped\n", g->tag);
+		return false;
+	}
+	if (sweet_mmio_rd(se, SE_STATUS) & 0x1001u) {
+		printf("%s: SE already busy; probes skipped\n", g->tag);
+		return false;
+	}
+	sweet_mmio_wr(se, 0xe18, 0); /* no GSI events */
+	sweet_mmio_wr(se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	sweet_mmio_wr(se, 0x644, 0);
+	sweet_mmio_wr(se, SE_IRQ_CLR, 0xffffffffu);
+	sweet_mmio_wr(se, 0x648, 0xffffffffu);
+	sweet_mmio_wr(se, SE_DMA, 0);
+	sweet_mmio_wr(se, 0x28, sweet_mmio_rd(se, 0x28) | 0x7fu);
+	sweet_mmio_wr(se, 0xe30, sweet_mmio_rd(se, 0xe30) | 0x0fu);
+	sweet_mmio_wr(se, 0x24, 0x7f);
+	sweet_mmio_wr(se, 0x20, 1);
+	sweet_mmio_wr(se, SE_CLK_SEL, 0);
+	sweet_mmio_wr(se, SE_MCLK, (7u << 4) | 1u);
+	sweet_mmio_wr(se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	/* Linux 8-bit I2C packing: MSB on the wire, LSB byte first in FIFO. */
+	sweet_mmio_wr(se, 0x254, 0);
+	sweet_mmio_wr(se, 0x260, SE_PACK0);
+	sweet_mmio_wr(se, 0x264, SE_PACK1);
+	sweet_mmio_wr(se, 0x284, SE_PACK0);
+	sweet_mmio_wr(se, 0x288, SE_PACK1);
+	sweet_mmio_wr(se, SE_TX_WM, 0);
+	sweet_mmio_wr(se, 0x810, 0);
+	sweet_mmio_wr(se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	sweet_mmio_wr(se, SE_IRQ_EN, SE_EVENTS);
+	printf("%s: packing tx=%#x/%#x rx=%#x/%#x gran=%#x\n", g->tag,
+	    sweet_mmio_rd(se, 0x260), sweet_mmio_rd(se, 0x264),
+	    sweet_mmio_rd(se, 0x284), sweet_mmio_rd(se, 0x288), sweet_mmio_rd(se, 0x254));
+	if (sweet_mmio_rd(se, 0x260) != SE_PACK0 || sweet_mmio_rd(se, 0x264) != SE_PACK1 ||
+	    sweet_mmio_rd(se, 0x284) != SE_PACK0 || sweet_mmio_rd(se, 0x288) != SE_PACK1 ||
+	    sweet_mmio_rd(se, 0x254) != 0) {
+		printf("%s: packing readback mismatch; probes skipped\n", g->tag);
+		return false;
+	}
+	if ((sweet_mmio_rd(se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (sweet_mmio_rd(se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("%s: inherited FIFO data; probes skipped\n", g->tag);
+		return false;
+	}
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_geni.h b/bsd/dev/sweet_geni.h
new file mode 100644
index 0000000..009f124
--- /dev/null
+++ b/bsd/dev/sweet_geni.h
@@ -0,0 +1,37 @@
+/*
+ * Polled FIFO-mode I2C on one Qualcomm GENI serial engine, shared by the
+ * touch drivers. The caller maps the SE and owns it; no DMA, no GSI, no
+ * interrupts: every transfer spins on the SE status registers.
+ */
+#ifndef _BSD_DEV_SWEET_GENI_H_
+#define _BSD_DEV_SWEET_GENI_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+
+struct sweet_geni {
+	vm_offset_t se;
+	const char *tag;        /* log prefix, e.g. "SWEET TOUCH" */
+	bool dead, probing;
+	uint32_t irq_status, irq_last;
+	unsigned sent, got;
+};
+
+uint32_t sweet_mmio_rd(vm_offset_t base, uint32_t off);
+void sweet_mmio_wr(vm_offset_t base, uint32_t off, uint32_t val);
+bool sweet_mmio_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask);
+
+/* GCC: vote the wrapper and SE branch clocks, XO/1 on the SE's RCG, check the halt bits. */
+bool sweet_geni_clocks(const char *tag, vm_offset_t gcc, uint32_t vote, uint32_t vote_mask,
+    uint32_t rcg, const uint32_t *halts, unsigned nhalts);
+/* Check the firmware ABL loaded and set the SE up for 100 kHz 8-bit FIFO I2C. */
+bool sweet_geni_setup(struct sweet_geni *g);
+/* One message: TX of at most 3 bytes or RX of at most 90; stretch keeps the bus for a repeated START. */
+int sweet_geni_msg(struct sweet_geni *g, uint8_t addr, const uint8_t *tx, unsigned nt,
+    uint8_t *rx, unsigned nr, bool stretch);
+/* Register read: 8 or 16-bit pointer write, repeated START, read len bytes. */
+int sweet_geni_read(struct sweet_geni *g, uint8_t addr, uint16_t reg, bool wide,
+    uint8_t *buf, unsigned len);
+
+#endif /* _BSD_DEV_SWEET_GENI_H_ */
