+/*
+ * One 8-byte event. Coordinate events (eid 0): tid 1..10, action in the
+ * top two bits, 12-bit x/y split over bytes 1-3, touch type in bytes 6/7.
+ * Status events (eid 1): type in bits 2-5, status id in byte 1.
+ */
+static void
+sects_event(const uint8_t *e, uint32_t *mask, int *x, int *y)
+{
+	unsigned eid = e[0] & 3u;
+	if (eid == SECTS_EID_COORDINATE) {
+		unsigned tid = (e[0] >> 2) & 0xfu, action = (e[0] >> 6) & 3u;
+		unsigned ttype = (((e[6] >> 6) & 3u) << 2) | ((e[7] >> 6) & 3u);
+		if (tid == 0 || tid > TOUCH_MAX || ttype != SECTS_TTYPE_NORMAL) {
+			return; /* palms, hover and side touches are not fingers */
+		}
+		unsigned id = tid - 1u;
+		unsigned px = ((unsigned)e[1] << 4) | (e[3] >> 4);
+		unsigned py = ((unsigned)e[2] << 4) | (e[3] & 0xfu);
+		if (action == SECTS_ACTION_RELEASE) {
+			*mask &= ~(1u << id);
+		} else if ((action == SECTS_ACTION_PRESS || action == SECTS_ACTION_MOVE) &&
+		    px < st.max_x && py < st.max_y) {
+			*mask |= 1u << id;
+			x[id] = touch_scale(px, st.max_x, st.panel_w);
+			y[id] = touch_scale(py, st.max_y, st.panel_h);
+		}
+	} else if (eid == SECTS_EID_STATUS) {
+		unsigned stype = (e[0] >> 2) & 0xfu;
+		if (stype == SECTS_STYPE_INFO && e[1] == SECTS_ACK_BOOT_COMPLETE && e[2] == SECTS_STATUS_APP_MODE) {
+			/* the IC's watchdog reset it: the vendor driver re-sends sense on */
+			printf("SWEET TOUCH: sec_ts rebooted; sense on again\n");
+			*mask = 0;
+			(void)sects_write(SECTS_CMD_SENSE_ON, NULL, 0);
+		} else if (stype == SECTS_STYPE_ERR && e[1] == SECTS_ERR_QUEUE_FULL) {
+			*mask = 0;
+		}
+	}
+}
+
+static int
+touch_sects(void)
+{
+	uint8_t e[SECTS_EVENT_LEN];
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	memcpy(x, st.x, sizeof(x));
+	memcpy(y, st.y, sizeof(y));
+	/* pop events until the IC's stack is empty (byte 7 holds the remaining count) */
+	for (unsigned n = 0; n < 32; ++n) {
+		int err = sects_read(SECTS_READ_ONE_EVENT, e, SECTS_EVENT_LEN);
+		if (err) {
+			return err;
+		}
+		if (e[0] == 0) {
+			break;
+		}
+		sects_event(e, &mask, x, y);
+		if ((e[7] & 0x3fu) == 0) {
+			break;
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
