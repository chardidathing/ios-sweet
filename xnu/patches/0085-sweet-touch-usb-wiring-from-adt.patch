+static uint32_t
+touch_prop32(DTEntry node, const char *name, uint32_t fallback, bool *found)
+{
+	uint32_t const *val;
+	unsigned int size;
+	if (SecureDTGetProperty(node, name, (void const **)&val, &size) == kSuccess && size == sizeof(*val)) {
+		if (found) {
+			*found = true;
+		}
+		return *val;
+	}
+	if (found) {
+		*found = false;
+	}
+	return fallback;
+}
