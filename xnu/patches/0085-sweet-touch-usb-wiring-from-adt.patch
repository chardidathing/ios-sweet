+static bool
+touch_config(DTEntry node)
+{
+	void const *prop;
+	unsigned int size;
+	bool ok;
+	if (SecureDTGetProperty(node, "protocol", &prop, &size) != kSuccess || size < 2) {
+		return false;
+	}
+	st.protocol = (const char *)prop;
+	if (SecureDTGetProperty(node, "se", &prop, &size) != kSuccess || size != 8) {
+		return false;
+	}
+	memcpy(&st.se_pa, prop, 8);
+	if (SecureDTGetProperty(node, "tlmm", &prop, &size) != kSuccess || size != 8) {
+		return false;
+	}
+	memcpy(&st.tlmm_pa, prop, 8);
+	st.gcc_vote = touch_prop32(node, "gcc-vote", 0, &ok);
+	st.gcc_vote_mask = touch_prop32(node, "gcc-vote-mask", 0, ok ? &ok : NULL);
+	st.gcc_rcg = touch_prop32(node, "gcc-rcg", 0, ok ? &ok : NULL);
+	if (!ok || SecureDTGetProperty(node, "gcc-halt", &prop, &size) != kSuccess ||
+	    size == 0 || size > TOUCH_HALTS * 4 || (size & 3u)) {
+		return false;
+	}
+	memcpy(st.gcc_halt, prop, size);
+	st.nhalts = size / 4;
+	st.sda = touch_prop32(node, "sda", 0, &ok);
+	st.scl = touch_prop32(node, "scl", 0, ok ? &ok : NULL);
+	st.mux = touch_prop32(node, "mux", 0, ok ? &ok : NULL);
+	st.reset = touch_prop32(node, "reset", 0, ok ? &ok : NULL);
+	st.irq = touch_prop32(node, "irq", 0, ok ? &ok : NULL);
+	st.max_x = touch_prop32(node, "max-x", 0, ok ? &ok : NULL);
+	st.max_y = touch_prop32(node, "max-y", 0, ok ? &ok : NULL);
+	if (!ok || st.max_x == 0 || st.max_y == 0) {
+		return false;
+	}
+	st.power_gpio = touch_prop32(node, "power-gpio", 0, &st.has_power_gpio);
+	st.rails_optional = touch_prop32(node, "rails-optional", 0, NULL) != 0;
+	if (SecureDTGetProperty(node, "rails", &prop, &size) == kSuccess && size > 0) {
+		const char *p = (const char *)prop, *end = p + size;
+		uint32_t const *mv;
+		unsigned int mvsize;
+		if (SecureDTGetProperty(node, "rails-mv", (void const **)&mv, &mvsize) != kSuccess) {
+			return false;
+		}
+		while (p < end && st.nrails < TOUCH_RAILS && (st.nrails + 1) * 4 <= mvsize) {
+			st.rail[st.nrails] = p;
+			st.rail_mv[st.nrails] = mv[st.nrails];
+			st.nrails++;
+			p += strlen(p) + 1;
+		}
+	}
+	return true;
+}
