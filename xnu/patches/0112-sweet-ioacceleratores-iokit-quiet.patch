diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 6ed0018..0f37057 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -146,6 +146,20 @@ public:
 
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
+/*
+ * the gpu's service class as QuartzCore looks for it: CAMetalContextCreate
+ * polls IOServiceMatching("IOAcceleratorES") 300 times, 100 ms apart, in
+ * every process that sets up CA rendering (30 s of lookups by backboardd at
+ * each boot on the pixel port). this one has no MetalPluginName, so Metal
+ * passes over it and CA still picks GLES (sweetgl). boot-arg sweetaccel=0
+ * leaves it out. idea from the ios-topaz fork.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
 class IOMobileFramebufferUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
 
@@ -248,6 +262,13 @@ AppleCLCD::start(IOService *provider)
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
 	registerService();
+	int accel = 1;
+	PE_parse_boot_argn("sweetaccel", &accel, sizeof(accel));
+	IOAcceleratorES *es = accel ? OSTypeAlloc(IOAcceleratorES) : NULL;
+	if (es != NULL && es->init() && es->attach(this)) {
+		es->registerService();
+	}
+	OSSafeReleaseNULL(es);
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u%s\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH, fMDP ? " by the mdp" : "");
 	return true;
