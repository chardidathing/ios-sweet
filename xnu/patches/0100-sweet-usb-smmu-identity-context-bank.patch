 /*
- * SMMUv2 global register space 0 (Linux arm-smmu.c). ABL leaves USB's stream
- * matched to its own translation context; a DMA to our memory through those
- * stale tables stalls the bus and resets the SoC. Linux installs its own
- * context, here the stream simply bypasses translation.
+ * SMMUv2 (Linux arm-smmu.c, arm-smmu-regs.h). ABL leaves USB's stream matched
+ * to its own translation context; a DMA to our memory through those stale
+ * tables stalls the bus and resets the SoC. S2CR bypass is not available:
+ * TrustZone turns a non-secure bypass request into a fault (type 2 reads
+ * back). What the downstream driver calls an S1-bypass domain works: a
+ * context bank of our own with translation disabled, which is an identity
+ * mapping.
  */
 #define SMMU_SCR0           0x000
 #define   SCR0_CLIENTPD     (1u << 0)
@@ -210,12 +213,37 @@ hsphy_rmw(vm_offset_t phy, uint32_t off, uint32_t mask, uint32_t val)
 #define   IDR0_NUMSMRG(v)   ((v) & 0xffu)
 #define   IDR0_EXIDS        (1u << 8)
 #define   IDR0_SMS          (1u << 27)  /* stream matching (bit 31 is the secure extension) */
+#define SMMU_IDR1           0x024
+#define   IDR1_NUMCB(v)     ((v) & 0xffu)
+#define   IDR1_NUMS2CB(v)   (((v) >> 16) & 0xffu)
+#define   IDR1_NUMPAGENDXB(v) (((v) >> 28) & 7u)
+#define   IDR1_PAGESIZE_64K (1u << 31)
+#define SMMU_TLBIALLNSNH    0x068
+#define SMMU_STLBGSYNC      0x070
+#define SMMU_STLBGSTATUS    0x074
 #define SMMU_SMR(n)         (0x800u + 4u * (n))
 #define   SMR_VALID         (1u << 31)
 #define SMMU_S2CR(n)        (0xc00u + 4u * (n))
 #define   S2CR_TYPE_MASK    (3u << 16)
-#define   S2CR_TYPE_BYPASS  (1u << 16)
+#define   S2CR_CBNDX_MASK   0xffu
 #define   S2CR_EXIDVALID    (1u << 10)
+#define SMMU_GR1_CBAR(n)    (4u * (n))
+#define   CBAR_S1_TRANS_S2_BYPASS (1u << 16)
+#define   CBAR_S1_BPSHCFG_NSH     (3u << 8)
+#define   CBAR_S1_MEMATTR_WB      (0xfu << 12)
+#define SMMU_GR1_CBA2R(n)   (0x800u + 4u * (n))
+#define   CBA2R_VA64        (1u << 0)
+#define SMMU_CB_SCTLR       0x000
+#define   SCTLR_CFRE        (1u << 5)
+#define   SCTLR_CFIE        (1u << 6)
+#define   SCTLR_CFCFG       (1u << 7)
+
+static void
+smmu_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
 
 static void
 usb_smmu_bypass(void)
@@ -223,32 +251,25 @@ usb_smmu_bypass(void)
 	if (usb_smmu_pa == 0) {
 		return;
 	}
-	vm_offset_t smmu = ml_io_map((vm_offset_t)usb_smmu_pa, 0x1000);
+	vm_offset_t smmu = ml_io_map((vm_offset_t)usb_smmu_pa, 0x100000);
 	if (smmu == 0) {
 		return;
 	}
-	uint32_t scr0 = usb_rd(smmu, SMMU_SCR0), idr0 = usb_rd(smmu, SMMU_IDR0);
-	unsigned nsmr = IDR0_NUMSMRG(idr0);
+	uint32_t scr0 = usb_rd(smmu, SMMU_SCR0), idr0 = usb_rd(smmu, SMMU_IDR0), idr1 = usb_rd(smmu, SMMU_IDR1);
+	unsigned nsmr = IDR0_NUMSMRG(idr0), numcb = IDR1_NUMCB(idr1), nums2cb = IDR1_NUMS2CB(idr1);
 	bool exids = (idr0 & IDR0_EXIDS) != 0;
